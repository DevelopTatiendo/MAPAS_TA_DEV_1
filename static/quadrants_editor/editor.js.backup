    if (paletteDiv) {
      PALETTE.forEach((hex, i) => {
        const s = document.createElement('div');
        s.className = 'swatch' + (i===0 ? ' active' : '');
        s.style.background = hex;
        s.dataset.color = hex;
        s.addEventListener('click', () => {
