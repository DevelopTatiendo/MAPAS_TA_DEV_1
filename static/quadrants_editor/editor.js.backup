            // Orden: comunas primero, luego cuadrantes
            features: [...comunas, ...enrichedQuads],
          };
          
          const fileName = `cuadrantes_${CITY.toLowerCase()}_${new Date().toISOString().slice(0,10)}.geojson`;
          downloadGeoJSON(combined, fileName);
          
