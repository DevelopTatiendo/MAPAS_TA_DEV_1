  SNAP_DISTANCE: 1.0, // tol_snapping = 1.0 m
  MIN_AREA_RESTO: 0.5, // Área mínima para considerar resto válido
  MAX_OVERLAP_AREA: 0.01, // area_tol = 0.01 m²
